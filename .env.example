# docker compose (로컬·prod)가 읽는 변수. 이 파일을 .env로 복사한 뒤 값을 넣는다.
# .env는 커밋하지 않는다.
# compose가 필요로 하는 변수:
DB_PASSWORD=change-me

# 앱 로그 디렉터리. 비우면 로컬은 ./logs, 컨테이너 이미지는 /var/log/contractcheck.
LOG_PATH=./logs

# 소셜 로그인(FR-AUTH-01). 제공자 콘솔에서 발급한 값을 .env에만 넣는다. 비우면 해당 제공자 로그인만 실패한다.
# 콜백 주소는 {서비스 주소}/login/oauth2/code/{kakao|naver|google} 로 제공자 콘솔에 등록한다.
FRONTEND_BASE_URL=http://localhost:3000
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 계약서 원본 보관소(FR-UPL-01, S3 호환 SeaweedFS). 버킷은 미리 만들어 둔다.
# 컨테이너 안의 앱에서 호스트의 저장소를 볼 때는 localhost 대신 컨테이너 네트워크 주소를 쓴다.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=contractcheck
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 저장소가 서버 측 암호화(SSE-S3)를 지원하지 않으면 false
# docker-compose.yml의 SeaweedFS는 SSE-S3 키 설정이 없어 app 컨테이너에서는 이 값을 무시하고 false로 고정한다.
# 호스트에서 앱을 직접 실행(IDE 등)할 때는 이 값이 적용되므로 로컬 SeaweedFS에 올리려면 false로 둔다.
STORAGE_SSE=true

# OCR 구현체(FR-UPL-02). 비우면 apple-vision(macOS 로컬 시연용, Xcode Command Line Tools 필요)이다.
# 운영(prod 프로필)은 upstage가 기본이며 아직 구현되지 않았다. Linux 컨테이너에서는 apple-vision을 쓸 수 없다.
# 첫 Apple Vision 인식은 모델 로딩으로 수십 초 걸릴 수 있어 제한 시간 기본값이 120초다.
OCR_PROVIDER=apple-vision
OCR_TIMEOUT=120s

# Python 추론 서버(FR-ANL-01). 로컬에서는 DATA의 모의 서버(api.mock_inference, 기본 키 dev-internal-key)를 8000번으로 띄운다.
INFERENCE_BASE_URL=http://localhost:8000
INFERENCE_API_KEY=dev-internal-key
