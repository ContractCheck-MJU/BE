<?xml version="1.0" encoding="UTF-8"?>
<!--
  Boot 기본 콘솔·파일 조각을 가져오고, dev/prod에만 ERROR 전용 롤링 파일을 추가한다.
  포맷·롤링 정책(크기·일수·gzip)·LOG_FILE은 application*.yml 의 logging.* 가 시스템 프로퍼티로 넘긴다.
-->
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<springProfile name="local | test">
		<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
		</root>
	</springProfile>

	<!-- local: 외부 호출 기록(ExternalCallLog)만 파일에도 쓴다. 바인딩 값 TRACE 같은 다른 로그는 콘솔에만 둔다.
	     dev·prod는 외부 호출 기록이 앱 로그 파일(contractcheck.log)에 함께 쌓인다. -->
	<springProfile name="local">
		<appender name="EXTERNAL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
			<encoder>
				<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5level [%X{requestId:-}] %msg%n</pattern>
				<charset>UTF-8</charset>
			</encoder>
			<file>${LOG_PATH:-./logs}/contractcheck-external.log</file>
			<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
				<fileNamePattern>${LOG_PATH:-./logs}/contractcheck-external.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
				<maxFileSize>100MB</maxFileSize>
				<totalSizeCap>1GB</totalSizeCap>
				<maxHistory>30</maxHistory>
			</rollingPolicy>
		</appender>
		<logger name="ac.mju.contractcheck.external" level="INFO">
			<appender-ref ref="EXTERNAL_FILE"/>
		</logger>
	</springProfile>

	<!-- dev·prod 공통: ECS JSON 파일. 콘솔은 프로필마다 따로 연다. -->
	<springProfile name="dev | prod">
		<include resource="org/springframework/boot/logging/logback/structured-file-appender.xml"/>
		<appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
			<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
				<level>ERROR</level>
			</filter>
			<encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
				<format>${FILE_LOG_STRUCTURED_FORMAT}</format>
				<charset>${FILE_LOG_CHARSET}</charset>
			</encoder>
			<file>${LOG_PATH:-./logs}/contractcheck-error.log</file>
			<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
				<fileNamePattern>${LOG_PATH:-./logs}/contractcheck-error.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
				<cleanHistoryOnStart>${LOGBACK_ROLLINGPOLICY_CLEAN_HISTORY_ON_START:-false}</cleanHistoryOnStart>
				<maxFileSize>${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE:-100MB}</maxFileSize>
				<totalSizeCap>${LOGBACK_ROLLINGPOLICY_TOTAL_SIZE_CAP:-3GB}</totalSizeCap>
				<maxHistory>${LOGBACK_ROLLINGPOLICY_MAX_HISTORY:-30}</maxHistory>
			</rollingPolicy>
		</appender>
	</springProfile>

	<!-- dev 콘솔은 local과 같은 사람이 읽는 패턴. 파일은 ECS JSON. -->
	<springProfile name="dev">
		<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
			<appender-ref ref="FILE"/>
			<appender-ref ref="ERROR_FILE"/>
		</root>
	</springProfile>

	<!-- prod 콘솔·파일 모두 ECS JSON. -->
	<springProfile name="prod">
		<include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>
		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
			<appender-ref ref="FILE"/>
			<appender-ref ref="ERROR_FILE"/>
		</root>
	</springProfile>

	<!-- 알 수 없는 프로필은 콘솔만 열어 로그가 사라지지 않게 한다. -->
	<springProfile name="!(local | test | dev | prod)">
		<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
		</root>
	</springProfile>
</configuration>
